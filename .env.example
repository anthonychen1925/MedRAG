# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must never be committed.

# --- Redis Cloud (Redis Vector Search) ---
# Either provide a full URL...
REDIS_URL=redis://default:PASSWORD@HOST:PORT
# ...or the individual fields (URL takes precedence if set):
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Name of the vector index created in Redis
REDIS_INDEX_NAME=medrag_kb

# --- Embeddings ---
# Which embedding backend to use: "bge" (local, free) | "voyage" (cloud, paid) | "stub"
EMBED_PROVIDER=bge

# BGE (local via sentence-transformers; no API key, no per-call cost).
# bge-large-en-v1.5 -> 1024 dims; bge-base -> 768; bge-small -> 384.
# Set BGE_DIM to match the model you choose (it is auto-corrected if it differs).
BGE_MODEL=BAAI/bge-large-en-v1.5
BGE_DIM=1024
BGE_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# Voyage AI (only used when EMBED_PROVIDER=voyage).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIM=1024

# --- Anthropic (reasoning) ---
# Only needed for the final report-generation step.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Pipeline behavior ---
# Use a deterministic local stub embedder instead of calling Voyage.
# Handy for building/testing the pipeline without burning API credits.
# Set to "true" to enable. NOTE: stub vectors are NOT semantically meaningful.
USE_STUB_EMBEDDER=false

# Retrieval tuning
# Chunks from the general (proposed-drug) query
RETRIEVAL_TOP_K=8
# Chunks retrieved per current-medication interaction query
RETRIEVAL_PER_PAIR_K=3
# Hard cap on total chunks passed to the model after merging
RETRIEVAL_MAX_CHUNKS=14
